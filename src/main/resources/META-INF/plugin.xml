<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>dev.yaee.expert</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Yaee: Elixir Expert</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>Yaee</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Elixir language support for IntelliJ-based IDEs powered by the Expert Language Server.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.lsp</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends>intellij.testRunner.plugin</depends>


    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="dev.yaee.expert.settings.ExpertSettings"/>
        <projectService serviceImplementation="dev.yaee.expert.credo.CredoSettings"/>
        <projectService serviceImplementation="dev.yaee.expert.credo.CredoRunner"/>
        <projectConfigurable parentId="language"
                instance="dev.yaee.expert.credo.CredoConfigurable"
                id="dev.yaee.expert.credo.settings" displayName="Credo"/>
        <applicationConfigurable
                parentId="language"
                instance="dev.yaee.expert.settings.ExpertConfigurable"
                id="dev.yaee.expert.settings.ExpertConfigurable"
                displayName="Elixir Expert"/>
        <platform.lsp.integrationProvider
                implementation="dev.yaee.expert.lsp.ExpertLspServerSupportProvider"/>
        <lang.parserDefinition language="Elixir"
                          implementationClass="dev.yaee.expert.lang.ElixirParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Elixir"
                          implementationClass="dev.yaee.expert.lang.ElixirSyntaxHighlighterFactory"/>
        <externalAnnotator language="Elixir" implementationClass="dev.yaee.expert.credo.CredoExternalAnnotator"/>
        <fileType name="Elixir"
                  language="Elixir"
                  implementationClass="dev.yaee.expert.lang.ElixirFileType"
                  fieldName="INSTANCE"
                  extensions="ex;exs"/>
        <fileIconProvider implementation="dev.yaee.expert.lang.ElixirFileIconProvider"/>
        <runLineMarkerContributor language="Elixir"
                                  implementationClass="dev.yaee.expert.testing.ExUnitRunLineMarkerContributor"/>
        <configurationType implementation="dev.yaee.expert.testing.ExUnitConfigurationType"/>
        <notificationGroup id="Elixir Expert" displayType="BALLOON"/>
        <directoryProjectGenerator implementation="dev.yaee.expert.project.ElixirProjectGenerator"/>
        <sdkType implementation="dev.yaee.expert.sdk.ElixirSdkType"/>
        <defaultLiveTemplates file="/liveTemplates/Elixir.xml"/>
        <liveTemplateContext contextId="ELIXIR"
                             implementation="dev.yaee.expert.lang.ElixirLiveTemplateContext"/>
        <codeInsight.template.postfixTemplateProvider language="Elixir"
                                 implementationClass="dev.yaee.expert.lang.ElixirPostfixTemplateProvider"/>
        <textmate.bundleProvider implementation="dev.yaee.expert.lang.ElixirTextMateBundleProvider"/>
    </extensions>

    <actions>
        <action id="ElixirExpert.NewFile"
                class="dev.yaee.expert.project.CreateElixirFileAction"
                text="Elixir File"
                description="Create an Elixir source, script, or template file">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
        <group id="ElixirExpert.ToolsMenu" text="Elixir" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="ElixirExpert.RunMixTests"
                    class="dev.yaee.expert.testing.RunMixTestsAction"
                    text="Run Mix Tests"/>
            <action id="ElixirExpert.MixFormat"
                    class="dev.yaee.expert.testing.MixFormatAction"
                    text="Run Mix Format"/>
            <action id="ElixirExpert.MixDepsGet"
                    class="dev.yaee.expert.testing.MixDepsGetAction"
                    text="Fetch Mix Dependencies"/>
        </group>
    </actions>

</idea-plugin>
