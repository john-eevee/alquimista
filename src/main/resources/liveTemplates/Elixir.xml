<templateSet group="Elixir">
    <template name="def" value="def $NAME$($ARGS$) do&#10;  $END$&#10;end" description="Define a public function"
              toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;function_name&quot;" alwaysStopAt="true"/>
        <variable name="ARGS" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="defp" value="defp $NAME$($ARGS$) do&#10;  $END$&#10;end" description="Define a private function"
              toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;function_name&quot;" alwaysStopAt="true"/>
        <variable name="ARGS" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="do" value="do&#10;  $END$&#10;end" description="Start a do block"
              toReformat="true" toShortenFQNames="false">
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="fn" value="fn $ARGS$ -&gt;&#10;  $END$&#10;end" description="Define an anonymous function"
              toReformat="true" toShortenFQNames="false">
        <variable name="ARGS" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="defmodule" value="defmodule $NAME$ do&#10;  $END$&#10;end" description="Define a module"
              toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;ModuleName&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="defmacro" value="defmacro $NAME$($ARGS$) do&#10;  $END$&#10;end" description="Define a public macro"
              toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;macro_name&quot;" alwaysStopAt="true"/>
        <variable name="ARGS" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="defmacrop" value="defmacrop $NAME$($ARGS$) do&#10;  $END$&#10;end" description="Define a private macro"
              toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;macro_name&quot;" alwaysStopAt="true"/>
        <variable name="ARGS" expression="" defaultValue="&quot;&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="defimpl" value="defimpl $PROTOCOL$, for: $TYPE$ do&#10;  $END$&#10;end" description="Implement a protocol"
              toReformat="true" toShortenFQNames="false">
        <variable name="PROTOCOL" expression="" defaultValue="&quot;Protocol&quot;" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="&quot;Type&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="case" value="case $EXPR$ do&#10;  $PATTERN$ -&gt;&#10;    $END$&#10;end"
              description="Start a case expression" toReformat="true" toShortenFQNames="false">
        <variable name="EXPR" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <variable name="PATTERN" expression="" defaultValue="&quot;:ok&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="with" value="with {:ok, $VALUE$} &lt;- $EXPR$ do&#10;  $END$&#10;end"
              description="Start a with expression" toReformat="true" toShortenFQNames="false">
        <variable name="VALUE" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <variable name="EXPR" expression="" defaultValue="&quot;fetch()&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="pipe" value="$EXPR$ |&gt; $END$" description="Pipe an expression into the next function"
              toReformat="true" toShortenFQNames="false">
        <variable name="EXPR" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="test" value="test &quot;$NAME$&quot; do&#10;  $END$&#10;end" description="Define an ExUnit test"
              toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;does something&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="describe" value="describe &quot;$NAME$&quot; do&#10;  $END$&#10;end"
              description="Group related ExUnit tests" toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;feature&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="ok" value="{:ok, $VALUE$}$END$" description="Return an ok tuple" toReformat="true"
              toShortenFQNames="false">
        <variable name="VALUE" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
    <template name="moduledoc" value="@moduledoc &quot;&quot;&quot;&#10;$END$&#10;&quot;&quot;&quot;"
              description="Add a module documentation block" toReformat="true" toShortenFQNames="false">
        <context>
            <option name="ELIXIR" value="true"/>
        </context>
    </template>
</templateSet>
